{
  "executionDefaults": {
    "timeoutSeconds": 30,
    "maxResultBytes": 65536
  },
  "tools": [
    {
      "name": "inspect_data",
      "description": "Inspect columns, types, missing values and row count.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": { "type": "string", "minLength": 4, "maxLength": 67 }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "basic_stats",
      "description": "Calculate sum, average, count, minimum or maximum for one field.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": { "type": "string", "minLength": 4, "maxLength": 67 },
          "metric": { "type": "string", "minLength": 1 },
          "operation": {
            "type": "string",
            "enum": ["sum", "average", "count", "minimum", "maximum"]
          }
        },
        "required": ["metric", "operation"],
        "additionalProperties": false
      }
    },
    {
      "name": "group_compare",
      "description": "Aggregate a numeric metric by a category.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": { "type": "string", "minLength": 4, "maxLength": 67 },
          "groupBy": { "type": "string", "minLength": 1 },
          "metric": { "type": "string", "minLength": 1 },
          "operation": {
            "type": "string",
            "enum": ["sum", "average", "count", "minimum", "maximum"]
          }
        },
        "required": ["groupBy", "metric", "operation"],
        "additionalProperties": false
      }
    },
    {
      "name": "trend_analysis",
      "description": "Aggregate a numeric metric over a date field; optional equality filters narrow the rows.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": { "type": "string", "minLength": 4, "maxLength": 67 },
          "dateField": { "type": "string", "minLength": 1 },
          "metric": { "type": "string", "minLength": 1 },
          "operation": {
            "type": "string",
            "enum": ["sum", "average", "count", "minimum", "maximum"]
          },
          "filters": { "type": "object" }
        },
        "required": ["dateField", "metric", "operation"],
        "additionalProperties": false
      }
    },
    {
      "name": "detect_anomaly",
      "description": "Detect numeric outliers using the deterministic 1.5 IQR rule.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": { "type": "string", "minLength": 4, "maxLength": 67 },
          "metric": { "type": "string", "minLength": 1 }
        },
        "required": ["metric"],
        "additionalProperties": false
      }
    },
    {
      "name": "top_n",
      "description": "Return the highest N records for a numeric metric.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": { "type": "string", "minLength": 4, "maxLength": 67 },
          "metric": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1, "maximum": 1000 }
        },
        "required": ["metric", "count"],
        "additionalProperties": false
      }
    },
    {
      "name": "scatter_data",
      "description": "Extract paired numeric values for two fields as deterministic scatter-chart points.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": { "type": "string", "minLength": 4, "maxLength": 67 },
          "xField": { "type": "string", "minLength": 1 },
          "yField": { "type": "string", "minLength": 1 }
        },
        "required": ["xField", "yField"],
        "additionalProperties": false
      }
    }
  ]
}
